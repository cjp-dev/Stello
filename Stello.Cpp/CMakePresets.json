{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-release",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release (baseline x86-64 + runtime BMI2, LTO)",
      "inherits": "base-release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -flto",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-flto -fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-flto -fuse-ld=lld"
      }
    },
    {
      "name": "clang-native",
      "displayName": "Clang Native (Zen 4 -march=native, LTO, scalar flips)",
      "inherits": "clang-release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -flto -march=native",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-flto -fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-flto -fuse-ld=lld"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (baseline x64 + runtime BMI2, /GL /LTCG)",
      "inherits": "base-release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob3 /GL /Gw /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/LTCG",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": "/LTCG"
      }
    },
    {
      "name": "msvc-native",
      "displayName": "MSVC Native (/arch:AVX2, /GL /LTCG)",
      "inherits": "msvc-release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob3 /GL /Gw /arch:AVX2 /DNDEBUG"
      }
    },
    {
      "name": "clang-sanitized",
      "displayName": "Clang ASan + UBSan (parity and UB verification)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "STELLO_SANITIZE": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-native",
      "configurePreset": "clang-native"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "msvc-native",
      "configurePreset": "msvc-native"
    },
    {
      "name": "clang-sanitized",
      "configurePreset": "clang-sanitized"
    }
  ],
  "testPresets": [
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-native",
      "configurePreset": "clang-native",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-native",
      "configurePreset": "msvc-native",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-sanitized",
      "configurePreset": "clang-sanitized",
      "output": { "outputOnFailure": true }
    }
  ]
}
