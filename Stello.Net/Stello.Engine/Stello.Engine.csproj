<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The P/Invoke source generator ([LibraryImport]) and the callbacks of the Rust engine (Native/StelloNative.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stello.Engine.Tests" />
    <InternalsVisibleTo Include="Stello.BookTool" />
    <InternalsVisibleTo Include="Stello.Benchmark" />
    <InternalsVisibleTo Include="Egaroucid.Engine.Tests" />
    <InternalsVisibleTo Include="Stello.Engine.V1" />
    <InternalsVisibleTo Include="Stello.Engine.V2" />
    <InternalsVisibleTo Include="Stello.Trainer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stello 2's trained evaluation (EvalWeights.Default). -->
    <EmbeddedResource Include="..\Book\stello-eval.bin" LogicalName="Stello.Engine.stello-eval.bin" />
  </ItemGroup>

  <!--
    The search runs in Rust (Stello.Rust, crate stello-ffi, library stello_engine). Before the build, Cargo builds it
    when its sources are newer than the library, and the library is copied to the output of this project and of every
    project that references it (apps, tools, tests), next to the assemblies.

    - Each OS has its own Cargo target folder (Stello.Rust/target/linux, target/windows), because the repository
      folder is shared between the Linux sandbox and Windows.
    - Cargo: from the PATH, else from ~/.cargo/bin (rustup's folder), else set StelloCargo to its path.
    - StelloCargoTarget=<triple> cross-compiles, e.g. x86_64-pc-windows-gnu (MinGW) to check the WPF output on Linux.
    - StelloNativeEngine=false skips Cargo and the library (for a build without Rust that never searches).
  -->
  <PropertyGroup>
    <StelloRustDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Stello.Rust'))</StelloRustDir>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</StelloNativeOS>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</StelloNativeOS>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == ''">linux</StelloNativeOS>
    <StelloCargoTargetDir>$(StelloRustDir)target$([System.IO.Path]::DirectorySeparatorChar)$(StelloNativeOS)$([System.IO.Path]::DirectorySeparatorChar)</StelloCargoTargetDir>

    <!-- The library's file name on the OS it runs on: the host's, or the one of StelloCargoTarget. -->
    <_StelloNativeRunsOn>$(StelloNativeOS)</_StelloNativeRunsOn>
    <_StelloNativeRunsOn Condition="'$(StelloCargoTarget)' != '' and $(StelloCargoTarget.Contains('windows'))">windows</_StelloNativeRunsOn>
    <_StelloNativeRunsOn Condition="'$(StelloCargoTarget)' != '' and $(StelloCargoTarget.Contains('apple'))">macos</_StelloNativeRunsOn>
    <_StelloNativeRunsOn Condition="'$(StelloCargoTarget)' != '' and $(StelloCargoTarget.Contains('linux'))">linux</_StelloNativeRunsOn>
    <StelloNativeFile Condition="'$(_StelloNativeRunsOn)' == 'windows'">stello_engine.dll</StelloNativeFile>
    <StelloNativeFile Condition="'$(_StelloNativeRunsOn)' == 'macos'">libstello_engine.dylib</StelloNativeFile>
    <StelloNativeFile Condition="'$(StelloNativeFile)' == ''">libstello_engine.so</StelloNativeFile>

    <_StelloCargoProfileDir>$(StelloCargoTargetDir)release</_StelloCargoProfileDir>
    <_StelloCargoProfileDir Condition="'$(StelloCargoTarget)' != ''">$(StelloCargoTargetDir)$(StelloCargoTarget)$([System.IO.Path]::DirectorySeparatorChar)release</_StelloCargoProfileDir>
    <StelloNativePath>$(_StelloCargoProfileDir)$([System.IO.Path]::DirectorySeparatorChar)$(StelloNativeFile)</StelloNativePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(StelloNativeEngine)' != 'false'">
    <!-- Flows to the output of every project that references Stello.Engine. -->
    <None Include="$(StelloNativePath)" Link="$(StelloNativeFile)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <StelloRustSource Include="$(StelloRustDir)Cargo.toml;$(StelloRustDir)Cargo.lock;$(StelloRustDir).cargo\config.toml" />
    <StelloRustSource Include="$(StelloRustDir)stello-core\Cargo.toml;$(StelloRustDir)stello-core\src\**\*.rs" />
    <StelloRustSource Include="$(StelloRustDir)stello-ffi\Cargo.toml;$(StelloRustDir)stello-ffi\src\**\*.rs" />
    <!-- Embedded by stello-core (include_bytes!). -->
    <StelloRustSource Include="..\Book\stello-eval.bin" />
    <!-- Visual Studio's fast up-to-date check: build when only the Rust sources changed. -->
    <UpToDateCheckInput Include="@(StelloRustSource)" />
  </ItemGroup>

  <Target Name="BuildStelloNative" BeforeTargets="BeforeBuild"
          Condition="'$(StelloNativeEngine)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloRustSource)" Outputs="$(StelloNativePath)">
    <!-- Cargo from the PATH, else rustup's folder. -->
    <Exec Command="cargo --version" Condition="'$(StelloCargo)' == ''" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloCargoOnPath" />
    </Exec>
    <PropertyGroup Condition="'$(StelloCargo)' == ''">
      <_StelloRustupCargo Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(USERPROFILE)\.cargo\bin\cargo.exe</_StelloRustupCargo>
      <_StelloRustupCargo Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(HOME)/.cargo/bin/cargo</_StelloRustupCargo>
      <StelloCargo Condition="'$(_StelloCargoOnPath)' == '0'">cargo</StelloCargo>
      <StelloCargo Condition="'$(StelloCargo)' == '' and Exists('$(_StelloRustupCargo)')">"$(_StelloRustupCargo)"</StelloCargo>
    </PropertyGroup>
    <Error Condition="'$(StelloCargo)' == ''"
           Text="Stello.Engine builds its search engine in Rust (Stello.Rust), but Cargo was not found on the PATH or in ~/.cargo/bin. Install Rust with rustup (https://rustup.rs). On Windows its default toolchain, x86_64-pc-windows-msvc, also needs Visual Studio's C++ build tools (the 'Desktop development with C++' workload, or 'MSVC v143 build tools' and a Windows SDK in the Visual Studio Installer). Then build again (restart Visual Studio so that it sees the new PATH), or set the MSBuild property StelloCargo to cargo's path." />

    <PropertyGroup>
      <_StelloCargoArguments>build --release -p stello-ffi --target-dir "$(StelloCargoTargetDir.TrimEnd('\/'))"</_StelloCargoArguments>
      <_StelloCargoArguments Condition="'$(StelloCargoTarget)' != ''">$(_StelloCargoArguments) --target $(StelloCargoTarget)</_StelloCargoArguments>
    </PropertyGroup>
    <Message Importance="high" Text="Stello.Engine: building the Rust engine ($(StelloCargo) $(_StelloCargoArguments))" />
    <!-- Incremental builds fail on some shared folders, and a release build does not use them anyway. -->
    <Exec Command="$(StelloCargo) $(_StelloCargoArguments)" WorkingDirectory="$(StelloRustDir)" EnvironmentVariables="CARGO_INCREMENTAL=0"
          ContinueOnError="true" IgnoreExitCode="true" CustomErrorRegularExpression="^error(\[E\d+\])?:">
      <Output TaskParameter="ExitCode" PropertyName="_StelloCargoExit" />
    </Exec>
    <Error Condition="'$(_StelloCargoExit)' != '0'"
           Text="Cargo could not build the Rust engine (Stello.Rust, stello-ffi; exit code $(_StelloCargoExit)); see Cargo's messages above. On Windows the toolchain x86_64-pc-windows-msvc needs Visual Studio's C++ build tools (link.exe): install the 'Desktop development with C++' workload in the Visual Studio Installer. 'rustup show' shows the installed toolchains." />
    <Error Condition="!Exists('$(StelloNativePath)')" Text="Cargo finished, but $(StelloNativePath) is missing." />
    <!-- Cargo leaves an up-to-date library alone; the new time stamp keeps this target from running again. -->
    <Touch Files="$(StelloNativePath)" />
  </Target>

</Project>
