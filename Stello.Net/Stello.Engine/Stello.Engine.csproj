<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The P/Invoke source generator ([LibraryImport]) and the callbacks of the C++ engine (Native/StelloNative.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stello.Engine.Tests" />
    <InternalsVisibleTo Include="Stello.BookTool" />
    <InternalsVisibleTo Include="Stello.Benchmark" />
    <InternalsVisibleTo Include="Egaroucid.Engine.Tests" />
    <InternalsVisibleTo Include="Stello.Engine.V1" />
    <InternalsVisibleTo Include="Stello.Engine.V2" />
    <InternalsVisibleTo Include="Stello.Trainer" />
  </ItemGroup>

  <!--
    The search runs in C++20 (Stello.Cpp, target stello_engine). Before the build, CMake + Ninja + Clang build it with
    -O3 -flto -DNDEBUG, STELLO_ABORT_EXCEPTIONS=ON and static CRT on Windows, when its sources are newer than the library,
    and the library is copied to the output of this project and of every project that references it (apps, tools, tests),
    next to the assemblies.

    - Each OS has its own CMake build folder (Stello.Cpp/build/windows-ffi, linux-ffi, macos-ffi), because the
      repository folder may be shared across OSes and separate from developer CMakePresets builds.
    - StelloLlvmBin can point to LLVM's bin folder if clang++ / llvm-ar are not on the PATH or in C:\Program Files\LLVM\bin.
    - StelloNativeEngine=false skips CMake and the native library (e.g. Stello.Web WASM publish).
  -->
  <PropertyGroup>
    <StelloCppDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Stello.Cpp'))</StelloCppDir>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</StelloNativeOS>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</StelloNativeOS>
    <StelloNativeOS Condition="'$(StelloNativeOS)' == ''">linux</StelloNativeOS>

    <StelloNativeFile Condition="'$(StelloNativeOS)' == 'windows'">stello_engine.dll</StelloNativeFile>
    <StelloNativeFile Condition="'$(StelloNativeOS)' == 'macos'">libstello_engine.dylib</StelloNativeFile>
    <StelloNativeFile Condition="'$(StelloNativeFile)' == ''">libstello_engine.so</StelloNativeFile>

    <StelloCppBuildDir>$(StelloCppDir)build$([System.IO.Path]::DirectorySeparatorChar)$(StelloNativeOS)-ffi</StelloCppBuildDir>
    <StelloNativePath>$(StelloCppBuildDir)$([System.IO.Path]::DirectorySeparatorChar)$(StelloNativeFile)</StelloNativePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(StelloNativeEngine)' != 'false'">
    <!-- Flows to the output of every project that references Stello.Engine. -->
    <None Include="$(StelloNativePath)" Link="$(StelloNativeFile)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <StelloCppSource Include="$(StelloCppDir)CMakeLists.txt;$(StelloCppDir)cmake\*.cmake;$(StelloCppDir)cmake\*.cmd" />
    <StelloCppSource Include="$(StelloCppDir)src\**\*.hpp;$(StelloCppDir)src\**\*.cpp" />
    <!-- Embedded by stello_core (cmake/embed_eval.cmake). -->
    <StelloCppSource Include="..\Book\stello-eval.bin" />
    <!-- Visual Studio's fast up-to-date check: rebuild when any C++ engine source changes. -->
    <UpToDateCheckInput Include="@(StelloCppSource)" />
  </ItemGroup>

  <Target Name="BuildStelloNative" BeforeTargets="BeforeBuild"
          Condition="'$(StelloNativeEngine)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloCppSource)" Outputs="$(StelloNativePath)">
    <Message Importance="high" Text="Stello.Engine: building the C++ engine (Stello.Cpp, stello_engine -> $(StelloCppBuildDir))" />

    <!-- Windows: build_ffi.cmd initializes vcvars64 (CMake, Ninja, Windows SDK CRT) and prepends LLVM clang++. -->
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="call &quot;$(StelloCppDir)cmake\build_ffi.cmd&quot; &quot;$(StelloCppDir.TrimEnd('\/'))&quot; &quot;$(StelloCppBuildDir)&quot;"
          WorkingDirectory="$(StelloCppDir)"
          EnvironmentVariables="STELLO_LLVM_BIN=$(StelloLlvmBin)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloCppExit" />
    </Exec>

    <!-- POSIX (Linux / macOS): configure and build stello_engine via CMake + Ninja + Clang. -->
    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <_StelloPosixLinkerFlags Condition="'$(StelloNativeOS)' != 'macos'">-DCMAKE_AR=llvm-ar -DCMAKE_RANLIB=llvm-ranlib "-DCMAKE_SHARED_LINKER_FLAGS_RELEASE=-flto -fuse-ld=lld"</_StelloPosixLinkerFlags>
      <_StelloPosixLinkerFlags Condition="'$(StelloNativeOS)' == 'macos'">"-DCMAKE_SHARED_LINKER_FLAGS_RELEASE=-flto"</_StelloPosixLinkerFlags>
      <_StelloPosixBuildCmd>cmake -S "$(StelloCppDir.TrimEnd('\/'))" -B "$(StelloCppBuildDir)" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=clang++ $(_StelloPosixLinkerFlags) "-DCMAKE_CXX_FLAGS_RELEASE=-O3 -DNDEBUG -flto" -DSTELLO_ABORT_EXCEPTIONS=ON -DSTELLO_BUILD_SHARED=ON -DSTELLO_BUILD_TESTS=OFF &amp;&amp; cmake --build "$(StelloCppBuildDir)" --target stello_engine</_StelloPosixBuildCmd>
    </PropertyGroup>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="$(_StelloPosixBuildCmd)"
          WorkingDirectory="$(StelloCppDir)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloCppExit" />
    </Exec>

    <Error Condition="'$(_StelloCppExit)' != '0'"
           Text="CMake/Clang could not build the C++ engine (Stello.Cpp, target stello_engine; exit code $(_StelloCppExit)); see the build messages above. Windows requires LLVM (clang++, llvm-ar, lld-link) and Visual Studio C++ build tools (CMake, Ninja, Windows SDK); Linux/macOS requires cmake, ninja, clang++ (and lld/llvm-ar on Linux)." />
    <Error Condition="!Exists('$(StelloNativePath)')" Text="The C++ build finished, but $(StelloNativePath) is missing." />
    <!-- Keep timestamps newer than sources so incremental .NET builds skip rebuilding. -->
    <Touch Files="$(StelloNativePath)" />
  </Target>

</Project>
