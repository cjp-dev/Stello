@page "/"
@using System.ComponentModel
@using System.Windows.Input
@using CommunityToolkit.Mvvm.Input
@using Stello.App.Models
@using Stello.Engine
@implements IDisposable
@inject MainViewModel Vm
@inject BrowserDialogService Dialogs
@inject AppearanceStore AppearanceStore
@inject IJSRuntime JS

<PageTitle>Stello. An Othello computer game.</PageTitle>

<div class="app" inert="@(Dialogs.Current is not null)">
    <!-- Top Menu Bar -->
    <nav class="menubar" aria-label="Menu">
        <div class="menubar-inner">
            <!-- Mobile Header (Visible on screens <= 768px) -->
            <div class="mobile-nav-bar">
                <span class="app-brand">Stello</span>
                <button class="hamburger-btn"
                        aria-label="Open navigation menu"
                        aria-expanded="@(_mobileDrawerOpen ? "true" : "false")"
                        @onclick="ToggleMobileDrawer">
                    <span class="hamburger-icon">☰</span>
                </button>
            </div>

            <!-- Desktop Menu Bar (Visible on screens > 768px) -->
            <div class="desktop-menu-bar">
                @foreach (MenuDefinition menu in _menus)
                {
                    <div class="menu">
                        <button class="menu-title @(menu == _openMenu ? "open" : null)"
                                aria-haspopup="menu"
                                aria-expanded="@(menu == _openMenu ? "true" : "false")"
                                @onclick="() => ToggleMenu(menu)"
                                @onmouseenter="() => HoverMenu(menu)">
                            @menu.Title
                        </button>
                        @if (menu == _openMenu)
                        {
                            <div class="menu-items" role="menu">
                                @foreach (MenuEntry entry in menu.Entries)
                                {
                                    bool? isChecked = entry.IsChecked?.Invoke();
                                    string role = isChecked is null ? "menuitem" : entry.Radio ? "menuitemradio" : "menuitemcheckbox";
                                    <button role="@role"
                                            aria-checked="@(isChecked is { } c ? (c ? "true" : "false") : null)"
                                            class="@(entry.SeparatorBefore ? "separator-before" : null)"
                                            disabled="@(!entry.Command.CanExecute(null))"
                                            @onclick="() => RunAsync(entry.Command)">
                                        <span class="check">@(isChecked == true ? (entry.Radio ? "●" : "✓") : "")</span>
                                        <span>@entry.Text</span>
                                        <span class="shortcut">@entry.Shortcut</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </nav>
    @if (_openMenu is not null)
    {
        <div class="menu-backdrop" @onclick="() => _openMenu = null"></div>
    }

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-drawer @(_mobileDrawerOpen ? "open" : null)" role="dialog" aria-modal="true" aria-label="Game Menu">
        <div class="mobile-drawer-header">
            <span class="mobile-drawer-title">Menu</span>
            <button class="mobile-drawer-close" aria-label="Close menu" @onclick="CloseMobileDrawer">✕</button>
        </div>
        <div class="mobile-drawer-body">
            @foreach (MenuDefinition menu in _menus)
            {
                <div class="mobile-menu-section">
                    <div class="mobile-section-header">@menu.Title</div>
                    <div class="mobile-section-items">
                        @foreach (MenuEntry entry in menu.Entries)
                        {
                            bool? isChecked = entry.IsChecked?.Invoke();
                            <button class="mobile-menu-item @(entry.SeparatorBefore ? "separator-before" : null)"
                                    disabled="@(!entry.Command.CanExecute(null))"
                                    @onclick="() => RunAsync(entry.Command)">
                                <span class="check">@(isChecked == true ? (entry.Radio ? "●" : "✓") : "")</span>
                                <span class="label">@entry.Text</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    @if (_mobileDrawerOpen)
    {
        <div class="mobile-drawer-backdrop" @onclick="CloseMobileDrawer"></div>
    }

    <!-- Main Content Area -->
    <main class="content">
        <!-- Interactive Board View -->
        <div class="board-area">
            <Board Squares="Vm.Squares" Appearance="_appearance" OnPlay="Play" />
        </div>

        <!-- Right Side Information Panels -->
        <div class="side-panels">
            <!-- Game Status Panel -->
            <section class="panel status-panel" role="status" aria-label="Game Status">
                <div class="panel-header">
                    <h2 class="@(Vm.IsStatusModified ? "status-modified" : null)">STATUS</h2>
                    <span class="mode-badge">@Vm.VariantBadgeText</span>
                    @if (Vm.IsGameSettingVisible)
                    {
                        <span class="setting-text">@Vm.SettingsBadgeText</span>
                    }
                </div>

                <div class="status-message">
                    <p class="status-main">@Vm.StatusText</p>
                    @if (Vm.IsThinking)
                    {
                        <div class="thinking-bar" role="progressbar" aria-label="AI Thinking">
                            <div class="thinking-progress"></div>
                        </div>
                    }
                </div>

                <!-- Dual-Card Scoreboard (Black moves first) -->
                <div class="pieces-scoreboard">
                    <!-- Black Player Card -->
                    <div class="score-card black-score @(Vm.ToMove == Player.Black && !Vm.IsGameOver ? "active-turn" : "")">
                        <div class="player-header @(Vm.IsClockVisible ? "" : "no-clock")">
                            <div class="player-title">
                                <span class="piece-dot black-dot"></span>
                                <span class="player-name">Black</span>
                            </div>
                            @if (Vm.IsClockVisible)
                            {
                                <span class="player-clock">@Vm.BlackClockText</span>
                            }
                        </div>
                        <span class="player-role">@Vm.BlackPlayerLabel</span>
                        <div class="piece-count">@Vm.BlackCount</div>
                        <span class="mobility-count">@Vm.BlackMobilityText</span>
                    </div>

                    <!-- White Player Card -->
                    <div class="score-card white-score @(Vm.ToMove == Player.White && !Vm.IsGameOver ? "active-turn" : "")">
                        <div class="player-header @(Vm.IsClockVisible ? "" : "no-clock")">
                            <div class="player-title">
                                <span class="piece-dot white-dot"></span>
                                <span class="player-name">White</span>
                            </div>
                            @if (Vm.IsClockVisible)
                            {
                                <span class="player-clock">@Vm.WhiteClockText</span>
                            }
                        </div>
                        <span class="player-role">@Vm.WhitePlayerLabel</span>
                        <div class="piece-count">@Vm.WhiteCount</div>
                        <span class="mobility-count">@Vm.WhiteMobilityText</span>
                    </div>
                </div>

                <!-- Quick Action Buttons -->
                <div class="action-buttons">
                    <button class="btn btn-secondary" disabled="@(!Vm.CanUndo)" @onclick="() => RunAsync(Vm.UndoCommand)">Undo</button>
                    <button class="btn btn-secondary" disabled="@(!Vm.CanRedo)" @onclick="() => RunAsync(Vm.RedoCommand)">Redo</button>
                    @if (Vm.IsVsComputer)
                    {
                        <button class="btn btn-warning" disabled="@(!Vm.IsThinking)" @onclick="() => RunAsync(Vm.MoveNowCommand)">Move Now</button>
                    }
                </div>
            </section>

            <!-- Real-Time AI Search Analysis Panel -->
            @if (Vm.IsAnalysisVisible)
            {
                <AnalysisPanel Analysis="Vm.Analysis" />
            }

            <!-- Move History Panel -->
            <section class="panel history-panel" aria-label="Move History">
                <h2>MOVE HISTORY (@Vm.MoveCountText)</h2>
                <div class="history-list">
                    @if (Vm.MoveHistoryList.Count == 0)
                    {
                        <p class="history-empty">No moves played yet.</p>
                    }
                    else
                    {
                        <ol>
                            @for (int i = 0; i < Vm.MoveHistoryList.Count; i++)
                            {
                                var move = Vm.MoveHistoryList[i];
                                <li>
                                    <span class="move-num">@(i + 1).</span>
                                    <span class="move-notation">@move.Notation</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>
        </div>
    </main>
</div>

@code {
    private MenuDefinition[] _menus = [];
    private ICommand[] _commands = [];
    private MenuDefinition? _openMenu;
    private bool _mobileDrawerOpen;
    private DotNetObjectReference<Home>? _self;
    private Appearance _appearance = Appearance.Default;
    private bool _renderPending;

    protected override void OnInitialized()
    {
        _appearance = AppearanceStore.Load();

        _menus =
        [
            new("File",
            [
                new("New Game", Vm.NewGameCommand),
                new("Open...", Vm.OpenCommand, "Ctrl+O"),
                new("Save", Vm.SaveCommand, "Ctrl+S"),
                new("Save As...", Vm.SaveAsCommand),
                new("Add Game to Book...", Vm.AddGameToBookCommand, SeparatorBefore: true),
            ]),
            new("Game",
            [
                new("vs Computer (Black)", new AsyncRelayCommand(() => Vm.SetGameMode(GameMode.HumanVsComputer)), IsChecked: () => Vm.IsHumanVsComputer, Radio: true),
                new("vs Computer (White)", new AsyncRelayCommand(() => Vm.SetGameMode(GameMode.ComputerVsHuman)), IsChecked: () => Vm.IsComputerVsHuman, Radio: true),
                new("vs Human (Two players)", new AsyncRelayCommand(() => Vm.SetGameMode(GameMode.HumanVsHuman)), IsChecked: () => Vm.IsHumanVsHuman, Radio: true),
                new("Switch sides", Vm.SwitchSidesCommand, SeparatorBefore: true),
                new("Settings...", Vm.EditSettingsCommand, SeparatorBefore: true),
            ]),
            new("Options",
            [
                new("Analysis", Vm.ToggleAnalysisCommand, "Ctrl+A", IsChecked: () => Vm.IsAnalysisVisible),
                new("Sound", Vm.ToggleSoundCommand, IsChecked: () => Vm.IsSoundOn),
                BoardEntry("Green Board", BoardStyle.Green, separatorBefore: true),
                BoardEntry("Golden Oak Board", BoardStyle.GoldenOak),
                BoardEntry("Reddish Wood Board", BoardStyle.ReddishWood),
                new("3D Pieces", ChangeAppearance(a => a with { Pieces3D = !a.Pieces3D }), IsChecked: () => _appearance.Pieces3D, SeparatorBefore: true),
                new("Animate Flips", ChangeAppearance(a => a with { AnimateFlips = !a.AnimateFlips }), IsChecked: () => _appearance.AnimateFlips),
            ]),
            new("Help",
            [
                new("User guide", new RelayCommand(OpenUserGuide), "F1"),
                new("Rules & Documentation", new RelayCommand(OpenDocs), "Shift+F1"),
                new("About Stello...", Vm.AboutCommand, SeparatorBefore: true),
            ]),
        ];

        _commands = _menus.SelectMany(menu => menu.Entries).Select(entry => entry.Command).ToArray();

        Vm.PropertyChanged += OnChanged;
        Dialogs.Changed += OnDialogChanged;
        foreach (SquareViewModel square in Vm.Squares)
        {
            square.PropertyChanged += OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged += OnChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("stello.registerShortcuts", _self);
            await JS.InvokeVoidAsync("stello.initMenuAlignment");
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnChanged;
        Dialogs.Changed -= OnDialogChanged;
        foreach (SquareViewModel square in Vm.Squares)
        {
            square.PropertyChanged -= OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged -= OnChanged;
        }

        if (_self is not null)
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("stello.unregisterShortcuts");
            ((IJSInProcessRuntime)JS).InvokeVoid("stello.cleanupMenuAlignment");
            _self.Dispose();
        }
    }

    [JSInvokable]
    public Task OnShortcut(string key) => Dialogs.Current is not null ? Task.CompletedTask : key switch
    {
        "o" => RunAsync(Vm.OpenCommand),
        "s" => RunAsync(Vm.SaveCommand),
        "m" => RunAsync(Vm.MoveNowCommand),
        "z" or "t" => RunAsync(Vm.UndoCommand),
        "y" or "f" => RunAsync(Vm.RedoCommand),
        "a" => RunAsync(Vm.ToggleAnalysisCommand),
        "f1" => RunUserGuide(),
        "shift+f1" => RunDocs(),
        _ => Task.CompletedTask,
    };

    private void HandleSquareClick(SquareViewModel square) => Play(square);

    private void Play(SquareViewModel square) => Vm.PlayCommand.Execute(square);

    private void OpenUserGuide() =>
        ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute("15-gui-and-settings"), "_blank", "noopener");

    private void OpenDocs() =>
        ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute(""), "_blank", "noopener");

    private Task RunUserGuide()
    {
        OpenUserGuide();
        return Task.CompletedTask;
    }

    private Task RunDocs()
    {
        OpenDocs();
        return Task.CompletedTask;
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        if (_renderPending)
        {
            return;
        }

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private void OnDialogChanged() => InvokeAsync(StateHasChanged);

    private MenuEntry BoardEntry(string text, BoardStyle board, bool separatorBefore = false) =>
        new(text, ChangeAppearance(a => a with { Board = board }), IsChecked: () => _appearance.Board == board, Radio: true, SeparatorBefore: separatorBefore);

    private RelayCommand ChangeAppearance(Func<Appearance, Appearance> change) => new(() =>
    {
        _appearance = change(_appearance);
        AppearanceStore.Save(_appearance);
    });

    private void ToggleMenu(MenuDefinition menu) => _openMenu = _openMenu == menu ? null : menu;

    private void ToggleMobileDrawer() => _mobileDrawerOpen = !_mobileDrawerOpen;

    private void CloseMobileDrawer() => _mobileDrawerOpen = false;

    private void HoverMenu(MenuDefinition menu)
    {
        if (_openMenu is not null)
        {
            _openMenu = menu;
        }
    }

    private async Task RunAsync(ICommand command)
    {
        _openMenu = null;
        _mobileDrawerOpen = false;
        if (!command.CanExecute(null))
        {
            return;
        }

        if (command is IAsyncRelayCommand asyncCommand)
        {
            await asyncCommand.ExecuteAsync(null);
        }
        else
        {
            command.Execute(null);
        }

        StateHasChanged();
    }

    private sealed record MenuDefinition(string Title, MenuEntry[] Entries);

    private sealed record MenuEntry(
        string Text,
        ICommand Command,
        string? Shortcut = null,
        Func<bool>? IsChecked = null,
        bool Radio = false,
        bool SeparatorBefore = false);
}
