@page "/"
@using System.ComponentModel
@using System.Windows.Input
@using CommunityToolkit.Mvvm.Input
@implements IDisposable
@inject MainViewModel Vm
@inject BrowserDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>@Vm.Title</PageTitle>

<div class="app" inert="@(Dialogs.Current is not null)">
    <nav class="menubar" aria-label="Menu">
        @foreach (MenuDefinition menu in _menus)
        {
            <div class="menu">
                <button class="menu-title @(menu == _openMenu ? "open" : null)" aria-haspopup="menu" aria-expanded="@(menu == _openMenu ? "true" : "false")"
                        @onclick="() => ToggleMenu(menu)" @onmouseenter="() => HoverMenu(menu)">@menu.Title</button>
                @if (menu == _openMenu)
                {
                    <div class="menu-items" role="menu">
                        @foreach (MenuEntry entry in menu.Entries)
                        {
                            bool? isChecked = entry.IsChecked?.Invoke();
                            <button role="@(isChecked is null ? "menuitem" : "menuitemcheckbox")" aria-checked="@(isChecked is { } c ? (c ? "true" : "false") : null)"
                                    disabled="@(!entry.Command.CanExecute(null))" @onclick="() => RunAsync(entry.Command)">
                                <span class="check">@(isChecked == true ? "✓" : "")</span>
                                <span>@entry.Text</span>
                                <span class="shortcut">@entry.Shortcut</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </nav>
    @if (_openMenu is not null)
    {
        <div class="menu-backdrop" @onclick="() => _openMenu = null"></div>
    }

    <main class="content @(Vm.IsAnalysisVisible ? null : "without-analysis")">
        <div class="board-area">
            <Board Squares="Vm.Squares" OnPlay="Play" />
        </div>

        @if (Vm.IsAnalysisVisible)
        {
            <aside class="analysis" aria-label="Analysis">
                <h2>Analysis</h2>
                <dl>
                    <dt>Move:</dt><dd>@Vm.Analysis.Move</dd>
                    <dt>Depth:</dt><dd>@Vm.Analysis.Depth</dd>
                    <dt>Value:</dt><dd>@Vm.Analysis.Value</dd>
                    <dt>Best move:</dt><dd>@Vm.Analysis.BestMove</dd>
                    <dt>Nodes:</dt><dd>@Vm.Analysis.Nodes</dd>
                    <dt>Evaluations:</dt><dd>@Vm.Analysis.Evaluations</dd>
                    <dt>Time:</dt><dd>@Vm.Analysis.Time</dd>
                </dl>
            </aside>
        }
    </main>

    <footer class="statusbar" role="status">
        <span>@Vm.Status</span>
        <span>Black @Vm.BlackCount – White @Vm.WhiteCount</span>
        <span>@Vm.SidesText</span>
        <span class="clock">@Vm.ClockText</span>
    </footer>
</div>

@code {
    private MenuDefinition[] _menus = [];
    private ICommand[] _commands = [];
    private MenuDefinition? _openMenu;
    private DotNetObjectReference<Home>? _self;

    protected override void OnInitialized()
    {
        // Evaluate Book and Self-play are only in the desktop version.
        _menus =
        [
            new("File",
            [
                new("New Game", Vm.NewGameCommand),
                new("Open...", Vm.OpenCommand, "Ctrl+O"),
                new("Save", Vm.SaveCommand, "Ctrl+S"),
                new("Save As...", Vm.SaveAsCommand),
            ]),
            new("Game",
            [
                new("Switch Sides", Vm.SwitchSidesCommand),
                new("Move Now", Vm.MoveNowCommand, "Ctrl+M"),
                new("Settings...", Vm.EditSettingsCommand),
            ]),
            new("Moves",
            [
                new("Back", Vm.UndoCommand, "Ctrl+Z"),
                new("Forward", Vm.RedoCommand, "Ctrl+Y"),
            ]),
            new("View", [new("Analysis", Vm.ToggleAnalysisCommand, "Ctrl+A", () => Vm.IsAnalysisVisible)]),
            new("Book", [new("Add Game to Book...", Vm.AddGameToBookCommand)]),
            new("Brain", [new("How Stello Thinks", new RelayCommand(OpenDocs))]),
            new("Help", [new("About Stello...", Vm.AboutCommand)]),
        ];
        _commands = _menus.SelectMany(menu => menu.Entries).Select(entry => entry.Command).ToArray();

        Vm.PropertyChanged += OnChanged;
        Vm.Analysis.PropertyChanged += OnChanged;
        Dialogs.Changed += OnDialogChanged;
        foreach (SquareViewModel square in Vm.Squares)
        {
            square.PropertyChanged += OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged += OnChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("stello.registerShortcuts", _self);
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnChanged;
        Vm.Analysis.PropertyChanged -= OnChanged;
        Dialogs.Changed -= OnDialogChanged;
        foreach (SquareViewModel square in Vm.Squares)
        {
            square.PropertyChanged -= OnChanged;
        }

        foreach (ICommand command in _commands)
        {
            command.CanExecuteChanged -= OnChanged;
        }

        if (_self is not null)
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("stello.unregisterShortcuts");
            _self.Dispose();
        }
    }

    [JSInvokable]
    public Task OnShortcut(string key) => Dialogs.Current is not null ? Task.CompletedTask : key switch
    {
        "o" => RunAsync(Vm.OpenCommand),
        "s" => RunAsync(Vm.SaveCommand),
        "m" => RunAsync(Vm.MoveNowCommand),
        "z" or "t" => RunAsync(Vm.UndoCommand),
        "y" or "f" => RunAsync(Vm.RedoCommand),
        "a" => RunAsync(Vm.ToggleAnalysisCommand),
        _ => Task.CompletedTask,
    };

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDialogChanged() => InvokeAsync(StateHasChanged);

    private void Play(SquareViewModel square) => Vm.PlayCommand.Execute(square);

    // A new tab, so the game stays open next to the documentation.
    private void OpenDocs() => ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute(""), "_blank", "noopener");

    private void ToggleMenu(MenuDefinition menu) => _openMenu = _openMenu == menu ? null : menu;

    private void HoverMenu(MenuDefinition menu)
    {
        if (_openMenu is not null)
        {
            _openMenu = menu;
        }
    }

    private async Task RunAsync(ICommand command)
    {
        _openMenu = null;
        if (!command.CanExecute(null))
        {
            return;
        }

        if (command is IAsyncRelayCommand asyncCommand)
        {
            await asyncCommand.ExecuteAsync(null);
        }
        else
        {
            command.Execute(null);
        }

        StateHasChanged();
    }

    private sealed record MenuDefinition(string Title, MenuEntry[] Entries);

    private sealed record MenuEntry(string Text, ICommand Command, string? Shortcut = null, Func<bool>? IsChecked = null);
}
