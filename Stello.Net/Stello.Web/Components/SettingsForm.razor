@using Stello.App.ViewModels

@* Stello's Settings form, shown in GameShell's dialog (DialogRequest.Body). *@
<fieldset class="settings">
    <legend>How long may the computer think?</legend>

    <label><input type="radio" name="mode" checked="@Settings.IsFixedDepth" @onchange="() => { Settings.IsFixedDepth = true; }" /> Fixed depth</label>
    <input type="range" min="1" max="@Settings.MaxDepth" aria-label="Depth" disabled="@(!Settings.IsFixedDepth)"
           @bind="Settings.Depth" @bind:event="oninput" />
    <span>@Settings.Depth plies</span>

    <label><input type="radio" name="mode" checked="@Settings.IsTimePerMove" @onchange="() => { Settings.IsTimePerMove = true; }" /> Time per move</label>
    <input type="range" min="1" max="@Settings.MaxSecondsPerMove" aria-label="Seconds per move" disabled="@(!Settings.IsTimePerMove)"
           @bind="Settings.SecondsPerMove" @bind:event="oninput" />
    <span>@Settings.SecondsPerMove seconds</span>

    <label><input type="radio" name="mode" checked="@Settings.IsTimePerGame" @onchange="() => { Settings.IsTimePerGame = true; }" /> Time per game</label>
    <input type="range" min="1" max="@Settings.MaxMinutesPerGame" aria-label="Minutes per game" disabled="@(!Settings.IsTimePerGame)"
           @bind="Settings.MinutesPerGame" @bind:event="oninput" />
    <span>@Settings.MinutesPerGame minutes</span>
</fieldset>

<fieldset class="settings">
    <legend>Stello Opening Book &amp; Transposition Table</legend>
    <label style="font-weight: normal; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <input type="checkbox" @bind="Settings.UseOpeningBook" />
        <span>Stello Opening Book (11,200 canonical positions)</span>
    </label>
    <div style="margin-top: 0.75rem;">
        <label style="margin-top: 0; display: block; margin-bottom: 0.25rem;">Transposition Table Capacity:</label>
        <select class="dialog-text" style="margin: 0.25rem 0;" @bind="Settings.TranspositionTableEntries">
            @foreach (TranspositionTableChoice choice in Settings.TranspositionTableChoices)
            {
                <option value="@choice.Value">@choice.Text</option>
            }
        </select>
    </div>
</fieldset>

<fieldset class="settings">
    <legend>Threads</legend>
    <div>
        <label style="margin-top: 0; display: block; margin-bottom: 0.25rem;">Search with (of @Settings.DeviceThreads on this device):</label>
        <select class="dialog-text" style="margin: 0.25rem 0;" aria-label="Threads" @bind="Settings.Threads">
            @foreach (ThreadChoice choice in Settings.ThreadChoices)
            {
                <option value="@choice.Value">@choice.Text</option>
            }
        </select>
    </div>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public SettingsViewModel Settings { get; set; } = default!;

    /// <summary>The form as a dialog body; as a component it re-renders itself while the user edits it.</summary>
    public static RenderFragment For(SettingsViewModel settings) => builder =>
    {
        builder.OpenComponent<SettingsForm>(0);
        builder.AddComponentParameter(1, nameof(Settings), settings);
        builder.CloseComponent();
    };
}
