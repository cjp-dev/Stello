<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- Publish compiles the app's .NET code to WebAssembly (needs: dotnet workload install wasm-tools). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stello.App\Stello.App.csproj" />
    <!-- The opening book, the book tracker and the game records; its search is not used here (see BuildStelloWasm). -->
    <ProjectReference Include="..\Stello.Engine\Stello.Engine.csproj" />
    <!-- The shared game GUI (git submodule). -->
    <ProjectReference Include="..\..\external\GameShell\src\GameShell\GameShell.csproj" />
  </ItemGroup>

  <!--
    Stello.Engine's native C++ library (libstello_engine.so / stello_engine.dll) flows to the output of every project
    that references it; the browser cannot load it, so it stays out of this app's output and publish folder.
  -->
  <Target Name="RemoveStelloNativeEngine" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_StelloNativeItem Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways);@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                         Condition="'%(Filename)' == 'libstello_engine' or '%(Filename)' == 'stello_engine'" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_StelloNativeItem)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_StelloNativeItem)" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_StelloNativeItem)" />
      <AllItemsFullPathWithTargetPath Remove="@(_StelloNativeItem)" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveStelloNativeEngineFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'libstello_engine' or '%(Filename)' == 'stello_engine'" />
    </ItemGroup>
  </Target>

  <!--
    The engine in the Web Worker (wwwroot/js/engine-worker.js) is Stello's C++ engine compiled to WebAssembly with
    Emscripten (Stello.Cpp, target stello_wasm). Before the build, CMake + Ninja + em++ build it into wwwroot/engine
    (git-ignored) when the C++ or glue sources are newer than the module. It is always a release build (-O3 -flto):
    a debug build would search many times slower.

    - Needs Emscripten SDK (emcmake / em++, installed via emsdk) on PATH, via EMSDK / StelloEmsdk, or in
      %USERPROFILE%\emsdk (~/emsdk), plus CMake and Ninja.
    - StelloWasmEngine=false skips both WebAssembly builds (for C#-only checks without Emscripten).

    The threaded build (BuildStelloWasmThreads) goes to wwwroot/engine-mt: the same C++ engine compiled with -pthread,
    shared memory up to 2 GiB, and Web Worker stack/TLS bootstrap glue (engine-pool-worker.js). The engine worker loads
    it only when the page asks for more than 1 thread and is cross-origin isolated, and falls back to wwwroot/engine
    otherwise.
    - StelloWasmThreads=auto (the default): built when Emscripten is available; StelloWasmThreads=required errors if
      Emscripten is missing (deploy workflow); StelloWasmThreads=false skips wwwroot/engine-mt.
  -->
  <PropertyGroup>
    <StelloCppDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Stello.Cpp'))</StelloCppDir>
    <_StelloWasmSingleBuildDir>$(StelloCppDir)build$([System.IO.Path]::DirectorySeparatorChar)wasm-st</_StelloWasmSingleBuildDir>
    <StelloWasmDir>$(MSBuildThisFileDirectory)wwwroot$([System.IO.Path]::DirectorySeparatorChar)engine</StelloWasmDir>
    <_StelloWasmModule>$(StelloWasmDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm_bg.wasm</_StelloWasmModule>
    <_StelloWasmJs>$(StelloWasmDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm.js</_StelloWasmJs>

    <StelloWasmThreads Condition="'$(StelloWasmThreads)' == ''">auto</StelloWasmThreads>
    <_StelloWasmMtBuildDir>$(StelloCppDir)build$([System.IO.Path]::DirectorySeparatorChar)wasm-mt</_StelloWasmMtBuildDir>
    <StelloWasmMtDir>$(MSBuildThisFileDirectory)wwwroot$([System.IO.Path]::DirectorySeparatorChar)engine-mt</StelloWasmMtDir>
    <_StelloWasmMtModule>$(StelloWasmMtDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm_bg.wasm</_StelloWasmMtModule>
    <_StelloWasmMtJs>$(StelloWasmMtDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm.js</_StelloWasmMtJs>
  </PropertyGroup>

  <ItemGroup Condition="'$(StelloWasmEngine)' != 'false'">
    <StelloWasmSource Include="$(StelloCppDir)CMakeLists.txt;$(StelloCppDir)cmake\build_wasm.cmd;$(StelloCppDir)cmake\build_wasm.sh;$(StelloCppDir)cmake\embed_eval.cmake" />
    <StelloWasmSource Include="$(StelloCppDir)src\**\*.hpp;$(StelloCppDir)src\**\*.cpp;$(StelloCppDir)src\wasm\stello_wasm.js" />
    <!-- Embedded by stello_core (cmake/embed_eval.cmake). -->
    <StelloWasmSource Include="..\Book\stello-eval.bin" />
    <UpToDateCheckInput Include="@(StelloWasmSource)" />
  </ItemGroup>

  <Target Name="BuildStelloWasm" BeforeTargets="AssignTargetPaths"
          Condition="'$(StelloWasmEngine)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloWasmSource)" Outputs="$(_StelloWasmModule);$(_StelloWasmJs)">
    <Message Importance="high" Text="Stello.Web: building the C++ WebAssembly engine (Stello.Cpp, single -> $(StelloWasmDir))" />

    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="call &quot;$(StelloCppDir)cmake\build_wasm.cmd&quot; &quot;$(StelloCppDir.TrimEnd('\/'))&quot; &quot;$(_StelloWasmSingleBuildDir)&quot; &quot;$(StelloWasmDir)&quot; single ON"
          WorkingDirectory="$(StelloCppDir)"
          EnvironmentVariables="STELLO_EMSDK=$(StelloEmsdk)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmExit" />
    </Exec>

    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(StelloCppDir)cmake/build_wasm.sh&quot; &quot;$(StelloCppDir.TrimEnd('\/'))&quot; &quot;$(_StelloWasmSingleBuildDir)&quot; &quot;$(StelloWasmDir)&quot; single ON"
          WorkingDirectory="$(StelloCppDir)"
          EnvironmentVariables="STELLO_EMSDK=$(StelloEmsdk)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmExit" />
    </Exec>

    <Error Condition="'$(_StelloWasmExit)' != '0'"
           Text="Emscripten could not build the WebAssembly engine (Stello.Cpp, target stello_wasm_stage; exit code $(_StelloWasmExit)); see the messages above. Install Emscripten SDK (emsdk) or set EMSDK / StelloEmsdk (or pass -p:StelloWasmEngine=false for C#-only checks)." />
    <Error Condition="!Exists('$(_StelloWasmModule)') or !Exists('$(_StelloWasmJs)')"
           Text="The Emscripten build finished, but $(_StelloWasmModule) or $(_StelloWasmJs) is missing." />
    <!-- Keep timestamps newer than sources so incremental .NET builds skip rebuilding. -->
    <Touch Files="$(_StelloWasmModule);$(_StelloWasmJs)" />
  </Target>

  <!-- The threaded build (see above): Emscripten with -pthread and shared linear memory into wwwroot/engine-mt. -->
  <Target Name="BuildStelloWasmThreads" BeforeTargets="AssignTargetPaths" AfterTargets="BuildStelloWasm"
          Condition="'$(StelloWasmEngine)' != 'false' and '$(StelloWasmThreads)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloWasmSource)" Outputs="$(_StelloWasmMtModule);$(_StelloWasmMtJs)">
    <Message Importance="high" Text="Stello.Web: building the threaded C++ WebAssembly engine (Stello.Cpp, threaded -> $(StelloWasmMtDir))" />

    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="call &quot;$(StelloCppDir)cmake\build_wasm.cmd&quot; &quot;$(StelloCppDir.TrimEnd('\/'))&quot; &quot;$(_StelloWasmMtBuildDir)&quot; &quot;$(StelloWasmMtDir)&quot; threaded ON"
          WorkingDirectory="$(StelloCppDir)"
          EnvironmentVariables="STELLO_EMSDK=$(StelloEmsdk)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmMtExit" />
    </Exec>

    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(StelloCppDir)cmake/build_wasm.sh&quot; &quot;$(StelloCppDir.TrimEnd('\/'))&quot; &quot;$(_StelloWasmMtBuildDir)&quot; &quot;$(StelloWasmMtDir)&quot; threaded ON"
          WorkingDirectory="$(StelloCppDir)"
          EnvironmentVariables="STELLO_EMSDK=$(StelloEmsdk)"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmMtExit" />
    </Exec>

    <Error Condition="'$(_StelloWasmMtExit)' != '0' and ('$(StelloWasmThreads)' == 'required' or '$(_StelloWasmMtExit)' != '2')"
           Text="Emscripten could not build the threaded WebAssembly engine (Stello.Cpp, target stello_wasm_stage; exit code $(_StelloWasmMtExit)); see the messages above. StelloWasmThreads=false builds the single-threaded engine only." />
    <Warning Condition="'$(_StelloWasmMtExit)' == '2' and '$(StelloWasmThreads)' != 'required'"
             Text="Emscripten was not found for the threaded WebAssembly engine; wwwroot/engine-mt will be omitted (StelloWasmThreads=false hides this warning)." />
    <RemoveDir Directories="$(StelloWasmMtDir)" Condition="'$(_StelloWasmMtExit)' == '2' and '$(StelloWasmThreads)' != 'required'" />

    <Error Condition="'$(_StelloWasmMtExit)' == '0' and (!Exists('$(_StelloWasmMtModule)') or !Exists('$(_StelloWasmMtJs)'))"
           Text="The threaded Emscripten build finished, but $(_StelloWasmMtModule) or $(_StelloWasmMtJs) is missing." />
    <Touch Condition="'$(_StelloWasmMtExit)' == '0'" Files="$(_StelloWasmMtModule);$(_StelloWasmMtJs)" />
  </Target>

  <!-- The engine's files are made during the build, so they are added as content here (as the book below). -->
  <Target Name="IncludeStelloWasm" BeforeTargets="AssignTargetPaths" AfterTargets="BuildStelloWasm;BuildStelloWasmThreads">
    <ItemGroup>
      <Content Remove="wwwroot\engine\**;wwwroot\engine-mt\**" />
      <Content Include="wwwroot\engine\**;wwwroot\engine-mt\**" />
    </ItemGroup>
  </Target>

  <!-- A linked file is not served by the dev server, so the shipped book is copied into wwwroot (git-ignored). -->
  <Target Name="CopyOpeningBook" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\Book\opening-book.bin" DestinationFiles="wwwroot\data\OPENING.bin" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\data\OPENING.bin" />
      <Content Include="wwwroot\data\OPENING.bin" />
    </ItemGroup>
  </Target>

  <!-- The documentation (docs) is shown by the Docs pages; copied into wwwroot like the book (git-ignored). -->
  <Target Name="CopyDocs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <DocsFile Include="..\..\docs\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocsFile)" DestinationFiles="@(DocsFile->'wwwroot\content\docs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\content\docs\**" />
      <Content Include="wwwroot\content\docs\**" />
    </ItemGroup>
  </Target>

  <!-- The picture in the About box, shared with the WPF app (git-ignored copy). -->
  <Target Name="CopyAboutPicture" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\Images\2026 Claus Pedersen.jpg" DestinationFiles="wwwroot\images\claus-pedersen.jpg" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\images\claus-pedersen.jpg" />
      <Content Include="wwwroot\images\claus-pedersen.jpg" />
    </ItemGroup>
  </Target>

</Project>
