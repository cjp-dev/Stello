<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- Publish compiles the app's .NET code to WebAssembly (needs: dotnet workload install wasm-tools). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stello.App\Stello.App.csproj" />
    <!-- The opening book, the book tracker and the game records; its search is not used here (see BuildStelloWasm). -->
    <ProjectReference Include="..\Stello.Engine\Stello.Engine.csproj" />
    <!-- The shared game GUI (git submodule). -->
    <ProjectReference Include="..\..\external\GameShell\src\GameShell\GameShell.csproj" />
  </ItemGroup>

  <!--
    Stello.Engine's native Rust library (libstello_engine.so / stello_engine.dll) flows to the output of every project
    that references it; the browser cannot load it, so it stays out of this app's output and publish folder.
  -->
  <Target Name="RemoveStelloNativeEngine" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_StelloNativeItem Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways);@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                         Condition="'%(Filename)' == 'libstello_engine' or '%(Filename)' == 'stello_engine'" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_StelloNativeItem)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_StelloNativeItem)" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_StelloNativeItem)" />
      <AllItemsFullPathWithTargetPath Remove="@(_StelloNativeItem)" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveStelloNativeEngineFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'libstello_engine' or '%(Filename)' == 'stello_engine'" />
    </ItemGroup>
  </Target>

  <!--
    The engine in the Web Worker (wwwroot/js/engine-worker.js) is Stello's Rust engine compiled to WebAssembly
    (Stello.Rust, crate stello-wasm). Before the build, Cargo builds it for wasm32-unknown-unknown and wasm-bindgen
    makes the module and its JavaScript glue (target web) in wwwroot/engine (git-ignored), when the Rust sources are
    newer than the module. It is always a release build: a debug build would search many times slower.

    - Needs Cargo (rustup), the target (rustup target add wasm32-unknown-unknown) and wasm-bindgen-cli of the version
      of the wasm-bindgen crate in Stello.Rust/Cargo.toml (0.2.130; the error messages below give the commands).
      Cargo and wasm-bindgen are taken from the PATH, else from ~/.cargo/bin, else from the properties StelloCargo and
      StelloWasmBindgen.
    - No wasm-opt: Binaryen's -O3 made the module neither faster nor much smaller (measured in phase 3).
    - The Cargo target folder is the OS's own one (Stello.Rust/target/linux, target/windows), as in Stello.Engine.
    - StelloWasmEngine=false skips all of this (a build that is not run, e.g. a check of the C# code without Rust).

    The threaded build (BuildStelloWasmThreads, Plans/making-stello-3-plan.md phase 8) goes to wwwroot/engine-mt: the
    same crate with shared memory and atomics, which needs a pinned nightly Rust (StelloWasmNightly) with rust-src
    (-Z build-std). The engine worker loads it only when the page asks for more than 1 thread and is cross-origin
    isolated, and falls back to wwwroot/engine otherwise.
    - StelloWasmThreads=auto (the default): built if the nightly and rust-src are installed; otherwise a warning, and
      the web app has the single-threaded engine only.
    - StelloWasmThreads=required: a missing nightly is an error (the deploy workflow). StelloWasmThreads=false: not built.
  -->
  <PropertyGroup>
    <StelloRustDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Stello.Rust'))</StelloRustDir>
    <_StelloWasmOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_StelloWasmOS>
    <_StelloWasmOS Condition="'$(_StelloWasmOS)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</_StelloWasmOS>
    <_StelloWasmOS Condition="'$(_StelloWasmOS)' == ''">linux</_StelloWasmOS>
    <_StelloWasmTargetDir>$(StelloRustDir)target$([System.IO.Path]::DirectorySeparatorChar)$(_StelloWasmOS)</_StelloWasmTargetDir>
    <_StelloWasmBuilt>$(_StelloWasmTargetDir)$([System.IO.Path]::DirectorySeparatorChar)wasm32-unknown-unknown$([System.IO.Path]::DirectorySeparatorChar)release$([System.IO.Path]::DirectorySeparatorChar)stello_wasm.wasm</_StelloWasmBuilt>
    <StelloWasmDir>$(MSBuildThisFileDirectory)wwwroot$([System.IO.Path]::DirectorySeparatorChar)engine</StelloWasmDir>
    <_StelloWasmModule>$(StelloWasmDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm_bg.wasm</_StelloWasmModule>

    <StelloWasmThreads Condition="'$(StelloWasmThreads)' == ''">auto</StelloWasmThreads>
    <StelloWasmNightly Condition="'$(StelloWasmNightly)' == ''">nightly-2026-11-02</StelloWasmNightly>
    <_StelloWasmMtTargetDir>$(StelloRustDir)target$([System.IO.Path]::DirectorySeparatorChar)$(_StelloWasmOS)-wasm-mt</_StelloWasmMtTargetDir>
    <_StelloWasmMtBuilt>$(_StelloWasmMtTargetDir)$([System.IO.Path]::DirectorySeparatorChar)wasm32-unknown-unknown$([System.IO.Path]::DirectorySeparatorChar)release$([System.IO.Path]::DirectorySeparatorChar)stello_wasm.wasm</_StelloWasmMtBuilt>
    <StelloWasmMtDir>$(MSBuildThisFileDirectory)wwwroot$([System.IO.Path]::DirectorySeparatorChar)engine-mt</StelloWasmMtDir>
    <_StelloWasmMtModule>$(StelloWasmMtDir)$([System.IO.Path]::DirectorySeparatorChar)stello_wasm_bg.wasm</_StelloWasmMtModule>
    <!--
      Shared memory (up to 2 GiB: the largest hash table setting takes 1 GiB) and the thread-local storage exports
      that wasm-bindgen's threads need.
    -->
    <_StelloWasmMtRustFlags>-C target-feature=+atomics,+bulk-memory,+mutable-globals -C link-arg=--shared-memory -C link-arg=--max-memory=2147483648 -C link-arg=--import-memory -C link-arg=--export=__wasm_init_tls -C link-arg=--export=__tls_size -C link-arg=--export=__tls_align -C link-arg=--export=__tls_base</_StelloWasmMtRustFlags>
  </PropertyGroup>

  <ItemGroup Condition="'$(StelloWasmEngine)' != 'false'">
    <StelloWasmSource Include="$(StelloRustDir)Cargo.toml;$(StelloRustDir)Cargo.lock;$(StelloRustDir).cargo\config.toml" />
    <StelloWasmSource Include="$(StelloRustDir)stello-core\Cargo.toml;$(StelloRustDir)stello-core\src\**\*.rs" />
    <StelloWasmSource Include="$(StelloRustDir)stello-wasm\Cargo.toml;$(StelloRustDir)stello-wasm\src\**\*.rs" />
    <!-- Embedded by stello-core (include_bytes!). -->
    <StelloWasmSource Include="..\Book\stello-eval.bin" />
    <UpToDateCheckInput Include="@(StelloWasmSource)" />
  </ItemGroup>

  <!-- Cargo, rustc and wasm-bindgen from the PATH, else rustup's folder (for both builds of the engine). -->
  <Target Name="_StelloFindWasmTools" Condition="'$(StelloWasmEngine)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <!-- Cargo, rustc and wasm-bindgen from the PATH, else rustup's folder. -->
    <PropertyGroup>
      <_StelloRustupBin Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(USERPROFILE)\.cargo\bin\</_StelloRustupBin>
      <_StelloRustupBin Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(HOME)/.cargo/bin/</_StelloRustupBin>
      <_StelloExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_StelloExe>
    </PropertyGroup>
    <Exec Command="cargo --version" Condition="'$(StelloCargo)' == ''" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloCargoOnPath" />
    </Exec>
    <PropertyGroup Condition="'$(StelloCargo)' == ''">
      <StelloCargo Condition="'$(_StelloCargoOnPath)' == '0'">cargo</StelloCargo>
      <_StelloRustc Condition="'$(_StelloCargoOnPath)' == '0'">rustc</_StelloRustc>
      <StelloCargo Condition="'$(StelloCargo)' == '' and Exists('$(_StelloRustupBin)cargo$(_StelloExe)')">"$(_StelloRustupBin)cargo$(_StelloExe)"</StelloCargo>
      <_StelloRustc Condition="'$(_StelloRustc)' == '' and Exists('$(_StelloRustupBin)rustc$(_StelloExe)')">"$(_StelloRustupBin)rustc$(_StelloExe)"</_StelloRustc>
    </PropertyGroup>
    <Exec Command="wasm-bindgen --version" Condition="'$(StelloWasmBindgen)' == ''" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmBindgenOnPath" />
    </Exec>
    <PropertyGroup Condition="'$(StelloWasmBindgen)' == ''">
      <StelloWasmBindgen Condition="'$(_StelloWasmBindgenOnPath)' == '0'">wasm-bindgen</StelloWasmBindgen>
      <StelloWasmBindgen Condition="'$(StelloWasmBindgen)' == '' and Exists('$(_StelloRustupBin)wasm-bindgen$(_StelloExe)')">"$(_StelloRustupBin)wasm-bindgen$(_StelloExe)"</StelloWasmBindgen>
    </PropertyGroup>
  </Target>

  <Target Name="BuildStelloWasm" BeforeTargets="AssignTargetPaths" DependsOnTargets="_StelloFindWasmTools"
          Condition="'$(StelloWasmEngine)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloWasmSource)" Outputs="$(_StelloWasmModule)">
    <Error Condition="'$(StelloCargo)' == ''"
           Text="Stello.Web builds its engine from Rust (Stello.Rust, crate stello-wasm), but Cargo was not found on the PATH or in ~/.cargo/bin. Install Rust with rustup (https://rustup.rs), then run: rustup target add wasm32-unknown-unknown, and: cargo install wasm-bindgen-cli --version 0.2.130 --locked. Or set the MSBuild property StelloCargo to cargo's path." />

    <!-- The target's standard library is in rustc's sysroot (rustup or not). -->
    <Exec Command="$(_StelloRustc) --print sysroot" Condition="'$(_StelloRustc)' != ''" ConsoleToMSBuild="true"
          ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StelloRustSysroot" />
    </Exec>
    <Error Condition="'$(_StelloRustSysroot)' != '' and !Exists('$(_StelloRustSysroot.Trim())/lib/rustlib/wasm32-unknown-unknown')"
           Text="Stello.Web builds its engine for WebAssembly, but Rust's wasm32-unknown-unknown target is not installed ($(_StelloRustSysroot.Trim())). Run: rustup target add wasm32-unknown-unknown" />

    <Error Condition="'$(StelloWasmBindgen)' == ''"
           Text="Stello.Web builds its engine for WebAssembly, but wasm-bindgen was not found on the PATH or in ~/.cargo/bin. Install the version of the wasm-bindgen crate in Stello.Rust/Cargo.toml: cargo install wasm-bindgen-cli --version 0.2.130 --locked. Or set the MSBuild property StelloWasmBindgen to its path." />

    <PropertyGroup>
      <_StelloWasmCargoArguments>build --release --target wasm32-unknown-unknown -p stello-wasm --target-dir "$(_StelloWasmTargetDir)"</_StelloWasmCargoArguments>
    </PropertyGroup>
    <Message Importance="high" Text="Stello.Web: building the WebAssembly engine ($(StelloCargo) $(_StelloWasmCargoArguments))" />
    <!-- Incremental builds fail on some shared folders, and a release build does not use them anyway. -->
    <Exec Command="$(StelloCargo) $(_StelloWasmCargoArguments)" WorkingDirectory="$(StelloRustDir)" EnvironmentVariables="CARGO_INCREMENTAL=0"
          ContinueOnError="true" IgnoreExitCode="true" CustomErrorRegularExpression="^error(\[E\d+\])?:">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmCargoExit" />
    </Exec>
    <Error Condition="'$(_StelloWasmCargoExit)' != '0'"
           Text="Cargo could not build the WebAssembly engine (Stello.Rust, stello-wasm, target wasm32-unknown-unknown; exit code $(_StelloWasmCargoExit)); see Cargo's messages above." />

    <Exec Command="$(StelloWasmBindgen) --target web --no-typescript --out-dir &quot;$(StelloWasmDir)&quot; &quot;$(_StelloWasmBuilt)&quot;"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmBindgenExit" />
    </Exec>
    <Error Condition="'$(_StelloWasmBindgenExit)' != '0'"
           Text="wasm-bindgen could not make the engine's package (exit code $(_StelloWasmBindgenExit)); see its messages above. wasm-bindgen-cli must be the version of the wasm-bindgen crate in Stello.Rust/Cargo.toml (cargo install wasm-bindgen-cli --version 0.2.130 --locked)." />

    <!-- Cargo leaves an up-to-date module alone; the new time stamp keeps this target from running again. -->
    <Touch Files="$(_StelloWasmModule)" />
  </Target>

  <!-- The threaded build (see above): Cargo with the pinned nightly, then wasm-bindgen into wwwroot/engine-mt. -->
  <Target Name="BuildStelloWasmThreads" BeforeTargets="AssignTargetPaths" AfterTargets="BuildStelloWasm"
          DependsOnTargets="_StelloFindWasmTools"
          Condition="'$(StelloWasmEngine)' != 'false' and '$(StelloWasmThreads)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(StelloWasmSource)" Outputs="$(_StelloWasmMtModule)">
    <!-- RUSTUP_AUTO_INSTALL=0: a build only asks whether the nightly is there, and does not download it. -->
    <Exec Command="$(_StelloRustc) +$(StelloWasmNightly) --print sysroot" Condition="'$(_StelloRustc)' != ''" ConsoleToMSBuild="true"
          EnvironmentVariables="RUSTUP_AUTO_INSTALL=0" IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StelloNightlySysroot" />
      <Output TaskParameter="ExitCode" PropertyName="_StelloNightlyExit" />
    </Exec>
    <PropertyGroup>
      <_StelloNightlyReady Condition="'$(_StelloNightlyExit)' == '0' and Exists('$(_StelloNightlySysroot.Trim())/lib/rustlib/src/rust/library')">true</_StelloNightlyReady>
      <_StelloNightlyHelp>The threaded WebAssembly engine needs Rust $(StelloWasmNightly) with rust-src. Run: rustup toolchain install $(StelloWasmNightly) --profile minimal --component rust-src</_StelloNightlyHelp>
    </PropertyGroup>
    <Error Condition="'$(_StelloNightlyReady)' != 'true' and '$(StelloWasmThreads)' == 'required'" Text="$(_StelloNightlyHelp)" />
    <Warning Condition="'$(_StelloNightlyReady)' != 'true' and '$(StelloWasmThreads)' != 'required'"
             Text="$(_StelloNightlyHelp) Without it the web app has only the single-threaded engine (StelloWasmThreads=false hides this warning)." />
    <!-- An old threaded build would not match the new single-threaded one: without the nightly there is none. -->
    <RemoveDir Directories="$(StelloWasmMtDir)" Condition="'$(_StelloNightlyReady)' != 'true'" />

    <PropertyGroup>
      <_StelloWasmMtCargoArguments>+$(StelloWasmNightly) build --release --target wasm32-unknown-unknown -p stello-wasm -Z build-std=std,panic_abort --target-dir "$(_StelloWasmMtTargetDir)"</_StelloWasmMtCargoArguments>
    </PropertyGroup>
    <Message Condition="'$(_StelloNightlyReady)' == 'true'" Importance="high"
             Text="Stello.Web: building the threaded WebAssembly engine ($(StelloCargo) $(_StelloWasmMtCargoArguments))" />
    <Exec Condition="'$(_StelloNightlyReady)' == 'true'" Command="$(StelloCargo) $(_StelloWasmMtCargoArguments)" WorkingDirectory="$(StelloRustDir)"
          EnvironmentVariables="CARGO_INCREMENTAL=0;RUSTFLAGS=$(_StelloWasmMtRustFlags)"
          ContinueOnError="true" IgnoreExitCode="true" CustomErrorRegularExpression="^error(\[E\d+\])?:">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmMtCargoExit" />
    </Exec>
    <Error Condition="'$(_StelloNightlyReady)' == 'true' and '$(_StelloWasmMtCargoExit)' != '0'"
           Text="Cargo could not build the threaded WebAssembly engine (Stello.Rust, stello-wasm, $(StelloWasmNightly); exit code $(_StelloWasmMtCargoExit)); see Cargo's messages above. StelloWasmThreads=false builds the single-threaded engine only." />
    <Exec Condition="'$(_StelloNightlyReady)' == 'true'"
          Command="$(StelloWasmBindgen) --target web --no-typescript --out-dir &quot;$(StelloWasmMtDir)&quot; &quot;$(_StelloWasmMtBuilt)&quot;"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_StelloWasmMtBindgenExit" />
    </Exec>
    <Error Condition="'$(_StelloNightlyReady)' == 'true' and '$(_StelloWasmMtBindgenExit)' != '0'"
           Text="wasm-bindgen could not make the threaded engine's package (exit code $(_StelloWasmMtBindgenExit)); see its messages above." />
    <Touch Condition="'$(_StelloNightlyReady)' == 'true'" Files="$(_StelloWasmMtModule)" />
  </Target>

  <!-- The engine's files are made during the build, so they are added as content here (as the book below). -->
  <Target Name="IncludeStelloWasm" BeforeTargets="AssignTargetPaths" AfterTargets="BuildStelloWasm;BuildStelloWasmThreads">
    <ItemGroup>
      <Content Remove="wwwroot\engine\**;wwwroot\engine-mt\**" />
      <Content Include="wwwroot\engine\**;wwwroot\engine-mt\**" />
    </ItemGroup>
  </Target>

  <!-- A linked file is not served by the dev server, so the shipped book is copied into wwwroot (git-ignored). -->
  <Target Name="CopyOpeningBook" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\Book\opening-book.bin" DestinationFiles="wwwroot\data\OPENING.bin" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\data\OPENING.bin" />
      <Content Include="wwwroot\data\OPENING.bin" />
    </ItemGroup>
  </Target>

  <!-- The documentation (docs) is shown by the Docs pages; copied into wwwroot like the book (git-ignored). -->
  <Target Name="CopyDocs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <DocsFile Include="..\..\docs\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocsFile)" DestinationFiles="@(DocsFile->'wwwroot\content\docs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\content\docs\**" />
      <Content Include="wwwroot\content\docs\**" />
    </ItemGroup>
  </Target>

  <!-- The picture in the About box, shared with the WPF app (git-ignored copy). -->
  <Target Name="CopyAboutPicture" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\Images\2026 Claus Pedersen.jpg" DestinationFiles="wwwroot\images\claus-pedersen.jpg" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\images\claus-pedersen.jpg" />
      <Content Include="wwwroot\images\claus-pedersen.jpg" />
    </ItemGroup>
  </Target>

</Project>
